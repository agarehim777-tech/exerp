{
  "name": "erpaz-operations-suite",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "build:pages": "vite build --base /exerp/",
    "preview": "vite preview --host 127.0.0.1",
    "preview:prod": "vite preview --host 127.0.0.1 --port 4173",
    "smoke": "node scripts/smoke.mjs",
    "smoke:prod": "node scripts/smoke-production.mjs",
    "verify:deploy": "node scripts/verify-deploy.mjs",
    "verify:security": "node scripts/verify-security-posture.mjs",
    "verify:core-backend": "node scripts/verify-core-backend.mjs",
    "verify:hardening": "node scripts/verify-transaction-hardening.mjs",
    "verify:recovery": "node scripts/verify-recovery.mjs",
    "verify:migrations": "node scripts/check-migration-order.mjs",
    "verify:release": "npm test && npm run verify:migrations && npm run verify:security && npm run verify:hardening && npm run build",
    "audit:interactions": "node scripts/interactive-audit.mjs",
    "audit:flows": "node scripts/business-flow-audit.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "verify:stock": "node scripts/verify-stock-lifecycle.mjs",
    "verify:credit": "node scripts/verify-credit-start.mjs",
    "verify:credit-payments": "node scripts/verify-credit-payments.mjs",
    "verify:operations": "node scripts/verify-operational-health.mjs"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.37",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@sentry/react": "^10.67.0",
    "@supabase/supabase-js": "^2.110.7",
    "ai": "^7.0.34",
    "dompurify": "^3.4.14",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.1",
    "recharts": "^3.9.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@lovable.dev/mcp-js": "^0.23.0",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.2",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.60.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.10"
  }
}

