{
  "name": "erpaz-operations-suite",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "build:pages": "vite build --base /ERP/",
    "preview": "vite preview --host 127.0.0.1",
    "preview:prod": "vite preview --host 127.0.0.1 --port 4173",
    "smoke": "node scripts/smoke.mjs",
    "smoke:prod": "node scripts/smoke-production.mjs",
    "verify:deploy": "node scripts/verify-deploy.mjs",
    "audit:interactions": "node scripts/interactive-audit.mjs",
    "audit:flows": "node scripts/business-flow-audit.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@lovable.dev/mcp-js": "^0.23.0",
    "@supabase/supabase-js": "^2.110.7",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.60.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.10"
  }
}
